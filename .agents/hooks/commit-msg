#!/bin/sh
# Appends the Antigravity Assisted-by trailer to commits made by the Antigravity agent, so its work
# is attributed even when the agent forgets the trailer. Commits made by a person are left alone.
#
# A commit counts as Antigravity's when any of these holds:
#   - the worktree lives under ~/.gemini/antigravity/ (where Antigravity creates its worktrees),
#   - an ancestor process is Antigravity's agent: the app's language_server or the agy CLI
#     (the IDE's integrated terminal runs under a different helper, so a person typing there is
#     not matched),
#   - ANTIGRAVITY_ASSISTED=1 is set (manual override; ANTIGRAVITY_ASSISTED=0 disables the hook).
# Installed by .agents/hooks/install.sh; chains to a commit-msg hook that was there before.
set -eu

msg_file="$1"
trailer='Assisted-by: Antigravity'

hook_dir=$(dirname "$0")
if [ -x "$hook_dir/commit-msg.local" ]; then
  "$hook_dir/commit-msg.local" "$@"
fi

is_antigravity() {
  case "${ANTIGRAVITY_ASSISTED:-}" in
    1) return 0 ;;
    0) return 1 ;;
  esac
  top=$(git rev-parse --show-toplevel 2>/dev/null || true)
  case "$top" in
    "$HOME"/.gemini/antigravity/*) return 0 ;;
  esac
  pid=$$
  depth=0
  while [ "$pid" -gt 1 ] && [ "$depth" -lt 40 ]; do
    cmd=$(ps -o command= -p "$pid" 2>/dev/null || true)
    case "$cmd" in
      */Antigravity.app/Contents/Resources/bin/language_server*) return 0 ;;
      */.gemini/antigravity-cli/*|agy\ *|*/bin/agy\ *|*/bin/agy) return 0 ;;
    esac
    pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ' || echo 1)
    [ -n "$pid" ] || pid=1
    depth=$((depth + 1))
  done
  return 1
}

is_antigravity || exit 0

# Antigravity is credited as an assistant, never as a co-author: drop a Co-Authored-By line naming it.
if grep -qi '^co-authored-by:[[:space:]]*antigravity' "$msg_file"; then
  tmp="$msg_file.assisted.$$"
  grep -vi '^co-authored-by:[[:space:]]*antigravity' "$msg_file" > "$tmp" || true
  mv "$tmp" "$msg_file"
fi

# Already attributed (any casing): nothing to do.
if grep -qi '^assisted-by:[[:space:]]*antigravity' "$msg_file"; then
  exit 0
fi

git interpret-trailers --in-place --trailer "$trailer" "$msg_file"
